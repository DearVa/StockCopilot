<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:StockCopilot.Views"
        xmlns:di="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        x:Class="StockCopilot.Views.MainWindow"
        Title="股票小助手"
        Width="1600" Height="700">

    <Panel>
        <v:MainView/>

        <di:DialogHost
            Identifier="MainDialogHost"
            CloseOnClickAway="False"/>
    </Panel>
</Window>