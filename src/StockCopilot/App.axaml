<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StockCopilot"
    xmlns:t="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
    xmlns:di="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:ic="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="StockCopilot.App"
    RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
    
    <Application.Resources>
        <FontFamily x:Key="FontFamily">宋体,Simsun,微软雅黑,Microsoft YaHei,苹方-简,宋体-简</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <Style Selector="InputElement">
            <Setter Property="TextBlock.FontFamily" Value="{StaticResource FontFamily}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}"/>
        </Style>
        <Style Selector="Label">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource FontFamily}"/>
        </Style>
        
        <t:MaterialTheme BaseTheme="Light" PrimaryColor="Purple" SecondaryColor="Indigo"/>
        <ic:MaterialIconStyles/>
        <di:DialogHostStyles/>
        
        <StyleInclude Source="Views/Controls/StockSearchSuggestBox.axaml"/>
        <StyleInclude Source="Views/StockComparisionView.axaml"/>
    </Application.Styles>
</Application>