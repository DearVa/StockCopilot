<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StockCopilot"
    xmlns:t="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
    xmlns:di="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:ic="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="StockCopilot.App"
    RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <t:MaterialTheme BaseTheme="Light" PrimaryColor="Purple" SecondaryColor="Indigo"/>
        <ic:MaterialIconStyles/>
        <di:DialogHostStyles/>
        
        <StyleInclude Source="Views/Controls/StockSearchSuggestBox.axaml"/>
        <StyleInclude Source="Views/StockComparisionView.axaml"/>
    </Application.Styles>
</Application>